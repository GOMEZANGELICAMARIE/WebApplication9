@model IEnumerable<WebApplication9.Models.Project>
@{
    ViewData["Title"] = "Portfolio - Table of Contents";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
    <h2 class="fw-bold text-uppercase m-0">Project Directory</h2>
    <a asp-controller="Account" asp-action="Logout" class="btn btn-bw-danger btn-sm px-3">Logout</a>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 p-2">
                <img src="@item.ThumbnailUrl" class="card-img-top border-bottom border-dark" alt="@item.Title" style="height: 200px; object-fit: cover; filter: grayscale(80%);">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold text-white mb-2">@item.Title</h5>
                    <p class="card-text text-secondary mb-3">@item.Description</p>
                    <p class="mb-3">
                        <a href="@item.GithubUrl" target="_blank" class="bw-link small">
                            GitHub Repository &rarr;
                        </a>
                    </p>
                    <div class="mt-auto">
                        <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-bw-outline w-100">View Project Details</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>